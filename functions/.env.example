# ============================================================
# ELA — Variables d'environnement des Cloud Functions
# Copier ce fichier en ".env" (sans .example) et remplir SUR TON PC.
# Le fichier .env ne doit JAMAIS être partagé, commité ou collé dans un chat.
# ============================================================

# Paystack (clé SECRÈTE sk_live_... ou sk_test_... — jamais dans le code)
PAYSTACK_SECRET=

# URL de retour après paiement (optionnel — défaut : https://ela-academy-7f868.web.app/#/payment/result)
PAYSTACK_CALLBACK_URL=

# OpenRouter (Learning Assistant — sk-or-v1-...)
OPENROUTER_KEY=
AI_PROVIDER=openrouter

# SendGrid (emails transactionnels — configuré AVANT le lancement)
SENDGRID_API_KEY=

# SendGrid — expéditeur vérifié (obligatoire pour l'envoi réel)
SENDGRID_FROM=

# ============================================================
# Mission 7 — Nurturing email des leads
# ============================================================
# Interrupteur MAÎTRE d'envoi : "false" = dry-run (aucun email réel).
# Passer à "true" UNIQUEMENT après vérification de SENDGRID_FROM,
# SPF/DKIM/DMARC et validation du propriétaire.
NURTURE_SEND_ENABLED=false

# Secret de signature des liens de désabonnement (chaîne aléatoire longue).
# Si absent, repli sur PAYSTACK_SECRET.
NURTURE_TOKEN_SECRET=

# HeyGen (vidéos de leçons — jalons ultérieurs)
HEYGEN_API_KEY=
