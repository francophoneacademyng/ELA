# ============================================================
# ELA — Variables d'environnement des Cloud Functions
# Copier ce fichier en ".env" (sans .example) et remplir SUR TON PC.
# Le fichier .env ne doit JAMAIS être partagé, commité ou collé dans un chat.
# ============================================================

# Paystack (clé SECRÈTE sk_live_... — jamais dans le code)
PAYSTACK_SECRET=

# OpenRouter (Learning Assistant — sk-or-v1-...)
OPENROUTER_KEY=
AI_PROVIDER=openrouter

# SendGrid (emails transactionnels — configuré AVANT le lancement)
SENDGRID_API_KEY=

# HeyGen (vidéos de leçons — jalons ultérieurs)
HEYGEN_API_KEY=
