rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function currentUserAcademy() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.academy;
    }

    function isTeacher() {
      return isSignedIn() && currentUserRole() == 'teacher';
    }

    function canCreateContent() {
      return isTeacher()
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.academy == currentUserAcademy()
        && request.resource.data.status == 'pending';
    }

    match /users/{uid} {
      allow create: if isSignedIn()
                    && request.auth.uid == uid;

      allow read: if isSignedIn()
                  && request.auth.uid == uid;

      // L'utilisateur met à jour son propre document, sans pouvoir changer
      // son rôle (le rôle est modifié uniquement par l'admin via le serveur).
      allow update: if isSignedIn()
                    && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    match /subscriptions/{uid} {
      allow read: if isSignedIn()
                  && request.auth.uid == uid;
      allow write: if false;
    }

    match /transactions/{reference} {
      allow read: if isSignedIn()
                  && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /lessons/{id} {
      allow create: if canCreateContent();
      allow read: if isSignedIn() && resource.data.teacherUid == request.auth.uid;
      allow read: if isSignedIn() && resource.data.status != 'pending';
      allow update: if isTeacher() && resource.data.teacherUid == request.auth.uid;
      allow delete: if isTeacher() && resource.data.teacherUid == request.auth.uid;
    }

    match /quizzes/{id} {
      allow create: if canCreateContent();
      allow read: if isSignedIn() && resource.data.teacherUid == request.auth.uid;
      allow read: if isSignedIn() && resource.data.status != 'pending';
      allow update: if isTeacher() && resource.data.teacherUid == request.auth.uid;
      allow delete: if isTeacher() && resource.data.teacherUid == request.auth.uid;
    }

    match /liveClasses/{id} {
      allow create: if canCreateContent();
      allow read: if isSignedIn() && resource.data.teacherUid == request.auth.uid;
      allow read: if isSignedIn() && resource.data.status != 'pending';
      allow update: if isTeacher() && resource.data.teacherUid == request.auth.uid;
      allow delete: if isTeacher() && resource.data.teacherUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
