rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function currentUserAcademy() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.academy;
    }

    function isTeacher() {
      return isSignedIn() && currentUserRole() == 'teacher';
    }

    function isAdmin() {
      return isSignedIn() && currentUserRole() == 'admin';
    }

    function hasActiveSubscription() {
      return exists(/databases/$(database)/documents/subscriptions/$(request.auth.uid))
        && get(/databases/$(database)/documents/subscriptions/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/subscriptions/$(request.auth.uid)).data.endDate > request.time;
    }

    function canCreateContent() {
      return isTeacher()
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.academy == currentUserAcademy()
        && request.resource.data.status == 'pending';
    }

    // Abonné actif : lit le contenu approuvé, SANS contrôle d'académie bloquant
    // (l'abonnement ouvre le plan entier, comme Francophone).
    function canStudentReadContent() {
      return isSignedIn()
        && resource.data.status == 'approved'
        && hasActiveSubscription();
    }

    match /users/{uid} {
      allow create: if isSignedIn()
                    && request.auth.uid == uid;

      allow read: if isAdmin();
      allow read: if isSignedIn()
                   && request.auth.uid == uid;

      // L'utilisateur met à jour son propre document, sans pouvoir changer
      // son rôle (le rôle est modifié uniquement par l'admin via le serveur).
      allow update: if isSignedIn()
                    && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    match /subscriptions/{uid} {
      allow read: if isAdmin();
      allow read: if isSignedIn()
                   && request.auth.uid == uid;
      allow write: if false;
    }

    match /transactions/{reference} {
      allow read: if isAdmin();
      allow read: if isSignedIn()
                   && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /lessons/{id} {
      allow create: if canCreateContent();
      allow read: if isAdmin();
      allow read: if isTeacher() && resource.data.teacherUid == request.auth.uid;
      allow read: if isTeacher() && resource.data.academy == currentUserAcademy();
      allow read: if resource.data.isTrial == true;
      allow read: if canStudentReadContent();
      allow update: if isTeacher() && resource.data.teacherUid == request.auth.uid
                    && request.resource.data.status == resource.data.status;
      allow delete: if isTeacher() && resource.data.teacherUid == request.auth.uid;
    }

    match /quizzes/{id} {
      allow create: if canCreateContent();
      allow read: if isAdmin();
      allow read: if isTeacher() && resource.data.teacherUid == request.auth.uid;
      allow read: if isTeacher() && resource.data.academy == currentUserAcademy();
      allow read: if resource.data.isTrial == true;
      allow read: if canStudentReadContent();
      allow update: if isTeacher() && resource.data.teacherUid == request.auth.uid
                    && request.resource.data.status == resource.data.status;
      allow delete: if isTeacher() && resource.data.teacherUid == request.auth.uid;
    }

    match /liveClasses/{id} {
      allow create: if canCreateContent();
      allow read: if isAdmin();
      allow read: if isTeacher() && resource.data.teacherUid == request.auth.uid;
      allow read: if isTeacher() && resource.data.academy == currentUserAcademy();
      allow read: if resource.data.isTrial == true;
      allow read: if canStudentReadContent();
      allow update: if isTeacher() && resource.data.teacherUid == request.auth.uid
                    && request.resource.data.status == resource.data.status;
      allow delete: if isTeacher() && resource.data.teacherUid == request.auth.uid;
    }

    // Cours (contenu propriétaire, status="approved").
    match /courses/{id} {
      allow read: if isAdmin();
      allow read: if isTeacher() && resource.data.academy == currentUserAcademy();
      allow read: if resource.data.isTrial == true;
      allow read: if canStudentReadContent();
      allow create, update, delete: if false;
    }

    // Progression de l'élève : un document par élève.
    match /progress/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Scores de quizz : l'élève n'écrit que ses propres scores.
    match /quizScores/{docId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Certificats : générés côté serveur ; lecture par le titulaire uniquement.
    match /certificates/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Tracking (Phase 0) : le client ne peut créer que les événements non sensibles
    // (page_view, registration, trial_started, checkout_started) avec champs validés.
    // payment_success est écrit UNIQUEMENT par le serveur (webhook Paystack, Admin SDK).
    match /marketingEvents/{id} {
      allow create: if request.resource.data.event in ['page_view', 'registration', 'trial_started', 'checkout_started']
                    && request.resource.data.ts is number;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
