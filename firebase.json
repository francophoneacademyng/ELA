{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "functions/**",
      "**/*.md",
      "firestore.rules",
      "firestore.indexes.json",
      "**/*.zip",
      "package.json",
      "package-lock.json",
      "**/*-debug.log",
      "**/*.log",
      "service-account*.json",
      "**/*.bak",
      "_*",
      "**/*.ps1",
      "**/*.exe",
      "**/*.err",
      "**/*.bat",
      "**/*.cmd",
      "**/*.py",
      "**/*.rules",
      "**/*.rar",
      "**/*.yml",
      "**/*.yaml",
      "ffmpeg/**",
      "video_pipeline/**",
      "docs/**",
      "scripts/**",
      "__pycache__/**",
      "**/__pycache__/**",
      "data/**",
      "firebase-test.json",
      "storage.rules",
      "find-error.js",
      "fix-syntax.js",
      "emu-*.js",
      "run-*.js",
      "emu*.txt",
      "pdfdiag*.txt",
      "RAPPORT-*.txt",
      "deploy-*.txt",
      "*-out*.txt",
      "*diag*.txt",
      "hs_err_pid*",
      "*deploy*",
      "deploy-log.txt"
    ],
    "redirects": [
      {
        "source": "/verifyELACertificate",
        "destination": "https://africa-south1-ela-academy-7f868.cloudfunctions.net/verifyELACertificate",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/unsubscribe",
        "function": "nurtureUnsubscribe"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/src/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/javascript; charset=utf-8"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/html; charset=utf-8"
          }
        ]
      },
      {
        "source": "**/*.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=utf-8"
          }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/css; charset=utf-8"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "pubsub": {
      "port": 8089
    },
    "ui": {
      "enabled": false
    }
  }
}
