{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "functions/**",
      "*.md",
      "firestore.rules",
      "firestore.indexes.json",
      "*.zip",
      "package.json",
      "package-lock.json",
      "*-debug.log",
      "*.log",
      "service-account*.json",
      "*.bak",
      "_*",
      "*.ps1",
      "*.exe",
      "*.err",
      "*.bat",
      "find-error.js",
      "fix-syntax.js",
      "scripts/**",
      "deploy-log.txt"
    ],
    "redirects": [
      {
        "source": "/**",
        "destination": "https://elaacademy.ng/:0",
        "type": 301,
        "condition": {
          "host": [
            "www.elaacademy.ng"
          ]
        }
      }
    ],
    "rewrites": [
      {
        "source": "/verifyELACertificate",
        "destination": "https://africa-south1-ela-academy-7f868.cloudfunctions.net/verifyELACertificate"
      },
      {
        "source": "/unsubscribe",
        "destination": "https://africa-south1-ela-academy-7f868.cloudfunctions.net/nurtureUnsubscribe"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/src/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/javascript; charset=utf-8"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/html; charset=utf-8"
          }
        ]
      },
      {
        "source": "**/*.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=utf-8"
          }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/css; charset=utf-8"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "pubsub": {
      "port": 8089
    },
    "ui": {
      "enabled": false
    }
  }
}
