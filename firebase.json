{
    "hosting":  {
                    "public":  ".",
                    "ignore":  [
                                   "firebase.json",
                                   ".firebaserc",
                                   "**/.*",
                                   "**/.*/**",
                                   "**/node_modules/**",
                                   "functions/**",
                                   "*.md",
                                   "firestore.rules",
                                   "firestore.indexes.json",
                                   "*.zip",
                                   "package.json",
                                   "package-lock.json"
                               ],
                    "rewrites":  [
                                     {
                                         "source":  "**",
                                         "destination":  "/index.html"
                                     }
                                 ]
                },
    "firestore":  {
                      "rules":  "firestore.rules",
                      "indexes":  "firestore.indexes.json"
                  },
    "functions":  [
                      {
                          "source":  "functions",
                          "codebase":  "default"
                      }
                  ]
}
